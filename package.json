{
  "name": "fintech-demo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Internal-tools prototype: refunds, KYC and feature flags on one shared authorization/policy/audit foundation.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/e2e"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @fintech-demo/api\" \"npm run dev -w @fintech-demo/web\"",
    "dev:api": "npm run dev -w @fintech-demo/api",
    "dev:web": "npm run dev -w @fintech-demo/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test -w @fintech-demo/api",
    "test:e2e": "npm run test -w @fintech-demo/e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @fintech-demo/api",
    "db:seed": "npm run db:seed -w @fintech-demo/api",
    "db:reset": "npm run db:reset -w @fintech-demo/api",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "db:test:setup": "npm run db:test:setup -w @fintech-demo/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
