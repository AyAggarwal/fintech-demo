# Copy to .env at the repository root. Both apps/api and tests read this file.

# PostgreSQL — a local cluster started by `npm run demo` from npm-installed binaries (data in .postgres/)
DATABASE_URL=postgresql://fintech:fintech@localhost:54329/fintech_demo
# Separate database used by integration tests (created on first `npm test`)
TEST_DATABASE_URL=postgresql://fintech:fintech@localhost:54329/fintech_demo_test

# API and web dev server. Defaults (shown) live in packages/contracts/src/local-dev.ts and are
# shared by the API, the Vite dev server/proxy and `npm run demo`; uncomment to override.
# API_PORT=3001
# API_HOST=127.0.0.1
# Origin allowed to call the API with cookies; its port is the Vite dev server port
# WEB_ORIGIN=http://localhost:5173

# Demo authentication. The demo login endpoint is only mounted when this is exactly "true".
# It must never be enabled in a production-like environment; see docs/architecture.md.
DEMO_AUTH_ENABLED=true
# Secret used to sign session cookies (any long random string for local use)
SESSION_SECRET=local-dev-only-change-me-0123456789abcdef
